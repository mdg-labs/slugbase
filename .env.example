# SlugBase — environment variable stubs (key names only; values via Infisical)
# Local: infisical run --env=dev -- <command>

# Required security secrets (spec §15)
SESSION_SECRET=
ENCRYPTION_KEY=

# Database (spec §11.9, §15) — PostgreSQL required (local/staging/prod)
# Local example: postgresql://slugbase:slugbase@localhost:5432/slugbase
# Docker one-liner: docker run -d --name slugbase-pg -e POSTGRES_USER=slugbase -e POSTGRES_PASSWORD=slugbase -e POSTGRES_DB=slugbase -p 5432:5432 postgres:16-alpine
DATABASE_URL=
# Neon hosted: direct/unpooled URL for migrations and drizzle-kit (optional; falls back to DATABASE_URL)
DATABASE_URL_UNPOOLED=

# Public URLs (spec §15)
APP_BASE_URL=
FRONTEND_ORIGIN=
# Marketing site origin for deploy smoke (Infisical staging / production)
MARKETING_ORIGIN=

# Cloudflare Access service token (CI staging smoke — Infisical staging only)
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Web → API URL (SSR loaders/actions + build-time client fallback)
API_BASE_URL=
VITE_API_URL=

# Deployment flags (spec §15)
PUBLIC_REGISTRATION=
EMAIL_VERIFICATION_REQUIRED=
SERVE_WEB_CLIENT=
WEB_CLIENT_SERVER_BUILD=

# SMTP transactional mail (spec §11.1, §15) — optional; no-op used when SMTP_HOST is absent
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# OpenAI AI suggestions (spec §11.2, §15) — optional; no-op used when OPENAI_API_KEY is absent
OPENAI_API_KEY=
OPENAI_MODEL=

# Stripe billing (spec §11.4, §15) — optional; no-op billing / full entitlements when absent
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Config-driven Stripe price ids (spec §12.1, def §6) — amounts live in Stripe, not app logic
STRIPE_PRICE_PERSONAL_MONTHLY=
STRIPE_PRICE_PERSONAL_ANNUAL=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_ANNUAL=
STRIPE_PRICE_SUPPORTER=
SUPPORTER_PROMOTION_END=
DOWNGRADE_GRACE_PERIOD_DAYS=

# Session TTL (spec §5.3, def §3) — sliding window; default 30 days
SESSION_TTL_DAYS=
SESSION_REMEMBER_TTL_DAYS=

# MFA TOTP issuer label shown in authenticator apps (spec §5.7)
MFA_TOTP_ISSUER=

# Rate limiting (spec §18, def §4) — in-memory store; distributed store is a Fast-Follow
RATE_LIMIT_LOGIN_MAX=
RATE_LIMIT_LOGIN_TTL_SECONDS=
RATE_LIMIT_TOKEN_CREATION_MAX=
RATE_LIMIT_TOKEN_CREATION_TTL_SECONDS=
# Signup + email-change verification sends per user (spec §5.5, §18)
RATE_LIMIT_EMAIL_VERIFICATION_MAX=
RATE_LIMIT_EMAIL_VERIFICATION_TTL_SECONDS=

# Cloudflare Turnstile challenge (spec §11.8, §15) — optional; no-op used when absent
TURNSTILE_SECRET_KEY=
# Skip challenge verification in development (defaults true when NODE_ENV !== production)
CHALLENGE_DEV_SKIP=

# Product analytics — Umami (spec §11.6, §15) — optional; no-op when UMAMI_HOST is absent
UMAMI_HOST=
UMAMI_WEBSITE_ID=

# Error reporting (spec §11.7, §15) — optional; no-op when SENTRY_DSN is absent
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=
SENTRY_PROFILING_SAMPLE_RATE=
SENTRY_LOG_LEVEL=
SENTRY_ENABLE_CONSOLE_LOGGING=
# CI/production build only — uploads source maps when set (spec §22)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# OpenAPI (spec §18) — GET /openapi.json always served; GET /docs when enabled
OPENAPI_INTERACTIVE_DOCS=

# Hosted billing UI config (packages/web — spec §12.1)
VITE_BILLING_ENABLED=
VITE_SUPPORTER_PROMOTION_END=
VITE_TEAM_BASE_SEATS=
VITE_FREE_BOOKMARK_CAP=

# Workspace settings panel visibility (packages/web — spec §10.1, §15)
VITE_MAIL_ADMIN_UI=
VITE_OIDC_ADMIN_UI=
VITE_AI_BYO_CREDENTIAL=
VITE_APP_BASE_URL=

# Web client Sentry traces sample rate (0.0–1.0; default 0.1) — spec §11.7
VITE_SENTRY_TRACES_SAMPLE_RATE=
# Web client Sentry replay sample rate (0.0–1.0; default 0.25) — spec §11.7
VITE_SENTRY_REPLAY_SAMPLE_RATE=
# Web client error reporting DSN (public; spec §11.7) — optional; no init when absent
VITE_SENTRY_DSN=
# Web client Sentry environment (staging / production) — set by CI; falls back to MODE
VITE_SENTRY_ENVIRONMENT=
# Web client Sentry release — set by CI from root package.json version; optional override
VITE_SENTRY_RELEASE=
# Server-side Sentry traces sample rate (0.0–1.0; default 0.1) — spec §11.7
SENTRY_TRACES_SAMPLE_RATE=
# Server-side Sentry replay sample rate (0.0–1.0; default 0.25) — spec §11.7
SENTRY_REPLAY_SAMPLE_RATE=

# Web client Umami analytics (public; spec §11.6) — optional; no tracker when absent
VITE_UMAMI_HOST=
VITE_UMAMI_WEBSITE_ID=

# Marketing site Umami analytics (public; spec §11.6) — optional; no tracker when absent
PUBLIC_UMAMI_HOST=
PUBLIC_UMAMI_WEBSITE_ID=

# Marketing site API base URL (public; spec §12.1) — fetches prices from GET /pricing/public
PUBLIC_API_BASE_URL=
# Marketing site pricing config (public; spec §12.1) — non-price config; display prices fetched from API
PUBLIC_SUPPORTER_PROMOTION_END=
PUBLIC_TEAM_BASE_SEATS=
PUBLIC_FREE_BOOKMARK_CAP=
# Deprecated display price env vars (kept as fallback when PUBLIC_API_BASE_URL is unset)
# PUBLIC_PLAN_PRICE_PERSONAL_MONTHLY=
# PUBLIC_PLAN_PRICE_PERSONAL_YEARLY=
# PUBLIC_PLAN_PRICE_TEAM_SEAT=
# PUBLIC_PLAN_PRICE_TEAM_SEAT_YEARLY=
# PUBLIC_PLAN_PRICE_SUPPORTER=

# Marketing site app links (public)
PUBLIC_FRONTEND_ORIGIN=
# Forwarding domain shown in marketing demos (illustrative; spec §23.4 — config-driven, never hard-coded)
PUBLIC_FORWARDING_DOMAIN=

# Marketing contact form (public; spec §2.3, §11.8)
PUBLIC_CONTACT_ENDPOINT=
PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Workers deploy (CI only — Infisical staging / prod)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Fly.io deploy (CI only — Infisical staging / prod; token scopes org access)
FLY_API_TOKEN=

# Infisical OIDC (CI only — GitHub Actions secrets, not local .env)
# INFISICAL_DOMAIN=
# INFISICAL_OIDC_IDENTITY_ID=
