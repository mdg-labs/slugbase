# Development configuration (doc 08 section 1.3). `pnpm dev:env` copies this
# file to .env and replaces SESSION_SECRET and ENCRYPTION_KEY with generated
# values. The values below match compose.dev.yml and are not secrets; a
# production process refuses to start with any of them (doc 01 section 11).
# Booleans are true, false, 1 or 0.
#
# Self-hosting with compose.yml: copy this file to .env and replace the
# development values of APP_ORIGIN, SESSION_SECRET, ENCRYPTION_KEY and
# ENCRYPTION_KEY_ID (the last two are base64 of 32 random bytes and a name for
# that key). compose.yml sets NODE_ENV to production and builds DATABASE_URL and
# DATABASE_MIGRATE_URL itself from the passwords below, so it ignores the
# values of NODE_ENV, DATABASE_URL and DATABASE_MIGRATE_URL in this file. The
# keys compose.yml reads for itself are not assignments in this file (it lists
# what the server and the worker read); set them in .env, names only here:
#   POSTGRES_PASSWORD     the password of the database's superuser (required)
#   APP_DB_PASSWORD       the password of the slugbase_app role (required)
#   MIGRATOR_DB_PASSWORD  the password of the slugbase_migrator role (required)
#   SLUGBASE_IMAGE        the image to run; default ghcr.io/mdg-labs/slugbase:latest
#   SLUGBASE_BIND         the address the server's port is published on; default 127.0.0.1
# The three passwords are used in database URLs, so use letters and digits only
# (for example the output of `openssl rand -hex 24`). They are applied when the
# database is first created; changing one later does not change the role.

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# The origin the browser sees (Vite in development; https in production)
APP_ORIGIN=http://localhost:5173

# Public listener and HTTP behaviour (server)
PORT=3000
# TRUSTED_PROXY_HOPS is how many reverse proxies in front of the server write
# X-Forwarded-For. compose.yml ships no reverse proxy and expects you to bring
# one, so behind it set this to 1 (the number of proxies in the chain). Left at
# 0 the server ignores X-Forwarded-For and sees only the proxy's address, so
# every client shares one bucket per per-IP rate limit below (one client can
# exhaust the login limit for everyone). Keep 0 only when clients connect to
# the server's port directly: a value above the real number of proxies lets a
# client choose its own address. A production start with 0 logs a warning.
TRUSTED_PROXY_HOPS=0
API_DOCS_ENABLED=true
DOCS_BASE_URL=https://slugbase.app/docs

# First-run setup (server). While the instance has no account, POST /setup
# creates the first account, its instance admin, and its workspace, exactly
# once. SETUP_ENABLED=false closes it for the deployment (an instance that must
# never have an instance admin). With SETUP_TOKEN_REQUIRED the server generates
# a token at each start while there is no account, prints it to its log, keeps
# only its hash, and setup needs the token of the latest start.
SETUP_ENABLED=true
SETUP_TOKEN_REQUIRED=true

# Public registration (server). PUBLIC_REGISTRATION=true lets a visitor create an
# account (POST /auth/register), created unverified, with a verification email
# sent to it when mail is configured. EMAIL_VERIFICATION_REQUIRED=true needs the
# SMTP keys below: without mail, POST /auth/register answers 503. A correct
# password for an account whose address was never verified then answers 403
# email_unverified and creates no session; POST /auth/verify-email/resend mails
# a new link. Unset, each takes the default of the build you run: the Community
# Edition opens no registration and does not require verification.
PUBLIC_REGISTRATION=
EMAIL_VERIFICATION_REQUIRED=

# Password policy (server). A password is 12 to 256 characters with no composition
# rules, and is refused when it is in the breached-password dataset shipped with
# the image (a local lookup; nothing is sent anywhere). BREACHED_PASSWORD_CHECK=false
# turns off the dataset check; the length rules still apply.
BREACHED_PASSWORD_CHECK=true

# Second factor (server). The name an authenticator app lists the account under.
# Unset, it is "SlugBase" followed by the host name of APP_ORIGIN (no port), for example
# "SlugBase (links.example.com)". 1 to 64 characters, no colon.
TOTP_ISSUER=

# Rate limits (server and worker): token buckets per operation bucket (doc 04
# section 7), RATE_LIMIT_<BUCKET>_<SCOPE>=<count>/<sec|min|hour>. IP is the client
# address across TRUSTED_PROXY_HOPS; ACCOUNT and WORKSPACE are the signed-in
# principal's; EMAIL is the target address of a credential operation. The values
# below are the defaults.
RATE_LIMIT_LOGIN_IP=10/min
RATE_LIMIT_LOGIN_EMAIL=20/hour
RATE_LIMIT_MFA_IP=10/min
RATE_LIMIT_MFA_ACCOUNT=30/hour
RATE_LIMIT_REGISTER_IP=5/hour
RATE_LIMIT_RESET_IP=5/hour
RATE_LIMIT_RESET_EMAIL=3/hour
RATE_LIMIT_TOKEN_REDEEM_IP=10/hour
RATE_LIMIT_TOKEN_REDEEM_ACCOUNT=10/hour
RATE_LIMIT_TOKEN_CREATE_IP=20/hour
RATE_LIMIT_TOKEN_CREATE_ACCOUNT=20/hour
RATE_LIMIT_SETUP_IP=10/hour
RATE_LIMIT_GO_IP=600/min
RATE_LIMIT_GO_ACCOUNT=300/min
RATE_LIMIT_READ_IP=1200/min
RATE_LIMIT_READ_ACCOUNT=1200/min
RATE_LIMIT_WRITE_IP=300/min
RATE_LIMIT_WRITE_ACCOUNT=120/min
RATE_LIMIT_BULK_IP=20/hour
RATE_LIMIT_BULK_ACCOUNT=20/hour
RATE_LIMIT_FETCH_IP=120/min
RATE_LIMIT_FETCH_ACCOUNT=60/min
RATE_LIMIT_AI_IP=60/hour
RATE_LIMIT_AI_ACCOUNT=60/hour
RATE_LIMIT_AI_WORKSPACE=600/hour
RATE_LIMIT_PUBLIC_IP=300/min

# Audit log retention (server and worker): how many days a workspace's audit events are kept
# before the hourly retention purge deletes them. 0 keeps them forever. A whole
# number from 0 to 36500.
AUDIT_RETENTION_DAYS=365

# Internal listener for /metrics (server and worker); unset means no listener.
# Keep it off the public network. Must differ from PORT.
METRICS_PORT=

# Error reporting (server and worker): a Sentry-protocol DSN of your own error
# tracker; unset reports nothing beyond the log. Personal data is scrubbed
# before anything is sent.
ERROR_REPORT_DSN=

# Mail (server and worker): an SMTP relay of your own. Leave all six unset to
# send no mail (messages are logged by recipient domain and template only).
# SMTP_HOST, SMTP_PORT, SMTP_SECURITY and SMTP_FROM are set together; SMTP_USER
# and SMTP_PASS are an optional pair, both or neither (leave both unset for a
# relay without authentication). A partial set refuses to start. SMTP_SECURITY
# is tls (TLS from the first byte, usually port 465), starttls (usually port
# 587) or none (plain text). The relay's certificate is verified. SMTP_FROM is
# an address, or a name and address such as SlugBase <slugbase@example.com>.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# OIDC sign-in (server): identity providers of your own, one set of keys per
# provider, where <SLUG> is a name you choose (upper-case letters and digits in
# groups joined by single underscores, such as GOOGLE or COMPANY_SSO). The keys
# are not assignments in this file because <SLUG> is yours; set them in .env
# for `pnpm dev`, or in .env.oidc next to compose.yml, which passes that file to
# the server container (.env does not reach it; names only here):
#   OIDC_<SLUG>_CLIENT_ID        required: the client id registered at the provider
#   OIDC_<SLUG>_CLIENT_SECRET    required: the client secret registered at the provider
#   OIDC_<SLUG>_ISSUER_URL       required: the issuer, which the provider's discovery
#                                document must name exactly; https in production
#   OIDC_<SLUG>_NAME             the name on the provider's button; default the slug
#   OIDC_<SLUG>_SCOPES           space or comma separated, with openid; default
#                                "openid email profile"
#   OIDC_<SLUG>_ENABLED          true or false; default true
#   OIDC_<SLUG>_AUTO_CREATE      true or false; default false
#   OIDC_<SLUG>_ALLOWED_DOMAINS  comma-separated email domains an auto-created account may
#                                have; default any
# An enabled provider missing a required key refuses to start and names the
# key. A provider that cannot be reached is left off the sign-in page and
# logged; nothing else is affected. The slug the sign-in page uses is <SLUG>
# in lower case with its underscores written as hyphens.

# Database: slugbase_app for the server and worker, slugbase_migrator for migrate
DATABASE_URL=postgres://slugbase_app:slugbase_app_dev_only@localhost:54329/slugbase_dev
DATABASE_MIGRATE_URL=postgres://slugbase_migrator:slugbase_migrator_dev_only@localhost:54329/slugbase_dev
MIGRATE_ON_START=true
SLUGBASE_ALLOW_OWNER_CONNECTION=false

# Secrets: SESSION_SECRET is at least 32 characters, ENCRYPTION_KEY is base64
# of 32 bytes. ENCRYPTION_KEY_ID names the key for rotation. After a rotation,
# ENCRYPTION_KEY_PREVIOUS lists the old keys as comma-separated id:key pairs
# (key as base64 of 32 bytes); they only open values sealed before the rotation.
SESSION_SECRET=development-session-secret-not-for-production-use
ENCRYPTION_KEY=ZGV2ZWxvcG1lbnQtZW5jcnlwdGlvbi1rZXktMDAwMDA=
ENCRYPTION_KEY_ID=dev-1
ENCRYPTION_KEY_PREVIOUS=
