# Development configuration (doc 08 section 1.3). `pnpm dev:env` copies this
# file to .env and replaces SESSION_SECRET and ENCRYPTION_KEY with generated
# values. The values below match compose.dev.yml and are not secrets; a
# production process refuses to start with any of them (doc 01 section 11).
# Booleans are true, false, 1 or 0.

# Runtime
NODE_ENV=development
LOG_LEVEL=info

# The origin the browser sees (Vite in development; https in production)
APP_ORIGIN=http://localhost:5173

# Public listener and HTTP behaviour (server)
PORT=3000
TRUSTED_PROXY_HOPS=0
API_DOCS_ENABLED=true
DOCS_BASE_URL=https://slugbase.app/docs

# Rate limits (server and worker): token buckets per operation bucket (doc 04
# section 7), RATE_LIMIT_<BUCKET>_<SCOPE>=<count>/<sec|min|hour>. IP is the client
# address across TRUSTED_PROXY_HOPS; ACCOUNT and WORKSPACE are the signed-in
# principal's; EMAIL is the target address of a credential operation. The values
# below are the defaults.
RATE_LIMIT_LOGIN_IP=10/min
RATE_LIMIT_LOGIN_EMAIL=20/hour
RATE_LIMIT_MFA_IP=10/min
RATE_LIMIT_MFA_ACCOUNT=30/hour
RATE_LIMIT_REGISTER_IP=5/hour
RATE_LIMIT_RESET_IP=5/hour
RATE_LIMIT_RESET_EMAIL=3/hour
RATE_LIMIT_TOKEN_REDEEM_IP=10/hour
RATE_LIMIT_TOKEN_CREATE_IP=20/hour
RATE_LIMIT_TOKEN_CREATE_ACCOUNT=20/hour
RATE_LIMIT_SETUP_IP=10/hour
RATE_LIMIT_GO_IP=600/min
RATE_LIMIT_GO_ACCOUNT=300/min
RATE_LIMIT_READ_IP=1200/min
RATE_LIMIT_READ_ACCOUNT=1200/min
RATE_LIMIT_WRITE_IP=300/min
RATE_LIMIT_WRITE_ACCOUNT=120/min
RATE_LIMIT_BULK_IP=20/hour
RATE_LIMIT_BULK_ACCOUNT=20/hour
RATE_LIMIT_FETCH_IP=120/min
RATE_LIMIT_FETCH_ACCOUNT=60/min
RATE_LIMIT_AI_IP=60/hour
RATE_LIMIT_AI_ACCOUNT=60/hour
RATE_LIMIT_AI_WORKSPACE=600/hour
RATE_LIMIT_PUBLIC_IP=300/min

# Internal listener for /metrics (server and worker); unset means no listener.
# Keep it off the public network. Must differ from PORT.
METRICS_PORT=

# Error reporting (server and worker): a Sentry-protocol DSN of your own error
# tracker; unset reports nothing beyond the log. Personal data is scrubbed
# before anything is sent.
ERROR_REPORT_DSN=

# Mail (server and worker): an SMTP relay of your own. Leave all six unset to
# send no mail (messages are logged by recipient domain and template only); set
# all six or none, a partial set refuses to start. SMTP_SECURITY is tls (TLS from
# the first byte, usually port 465), starttls (usually port 587) or none (plain
# text). The relay's certificate is verified. SMTP_FROM is an address, or a name
# and address such as SlugBase <slugbase@example.com>.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Database: slugbase_app for the server and worker, slugbase_migrator for migrate
DATABASE_URL=postgres://slugbase_app:slugbase_app_dev_only@localhost:54329/slugbase_dev
DATABASE_MIGRATE_URL=postgres://slugbase_migrator:slugbase_migrator_dev_only@localhost:54329/slugbase_dev
MIGRATE_ON_START=true
SLUGBASE_ALLOW_OWNER_CONNECTION=false

# Secrets: SESSION_SECRET is at least 32 characters, ENCRYPTION_KEY is base64
# of 32 bytes. ENCRYPTION_KEY_ID names the key for rotation. After a rotation,
# ENCRYPTION_KEY_PREVIOUS lists the old keys as comma-separated id:key pairs
# (key as base64 of 32 bytes); they only open values sealed before the rotation.
SESSION_SECRET=development-session-secret-not-for-production-use
ENCRYPTION_KEY=ZGV2ZWxvcG1lbnQtZW5jcnlwdGlvbi1rZXktMDAwMDA=
ENCRYPTION_KEY_ID=dev-1
ENCRYPTION_KEY_PREVIOUS=
