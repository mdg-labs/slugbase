{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "globalDependencies": ["eslint.config.js", "tooling/boundaries/**", "tooling/vocabulary/**", "vitest.shared.ts", "tsconfig.base.json"],
  "tasks": {
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@slugbase/tooling#lint": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/**"],
      "outputs": []
    },
    "@slugbase/tooling#i18n:check": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/*/src/i18n/**"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": ["*.tsbuildinfo", ".tsbuildinfo/**"]
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "@slugbase/contracts#test:unit": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/internal/04-api.md",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/api-extractor.base.json",
        "$TURBO_ROOT$/tooling/api-report/**"
      ],
      "outputs": ["coverage/**"]
    },
    "@slugbase/tooling#test:unit": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/api-extractor.base.json",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/*/api-extractor.json",
        "$TURBO_ROOT$/packages/*/etc/**"
      ],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "contracts:check": {
      "dependsOn": ["^build", "build"],
      "outputs": [],
      "cache": false
    },
    "db:check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "i18n:check": {
      "outputs": []
    }
  }
}
