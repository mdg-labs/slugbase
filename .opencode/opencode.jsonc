{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "external_directory", "resource": "/tmp/opencode/*", "effect": "allow" }
  ],
  // Mirrors the deny rules in .claude/settings.json. Policies are hard denies that no agent rule can lift.
  "policies": [
    { "action": "tool.use", "resource": "shell:git push *--force*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push -f*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push * -f*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git add -A*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git add --all*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git add .", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git add ./ *", "effect": "deny" },
    // The production branch moves only through a merged pull request (.claude/rules/mdg-git.md).
    { "action": "tool.use", "resource": "shell:git push origin main*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push * HEAD:main*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push * HEAD:refs/heads/main*", "effect": "deny" }
  ]
}
