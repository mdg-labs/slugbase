# syntax=docker/dockerfile:1
# CE web SSR container — ghcr.io/mdg-labs/slugbase-web; Cloud uses same Dockerfile (spec §14.2)

FROM node:22-bookworm-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}:${PATH}"
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app

FROM base AS build-deps
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json tsconfig.json ./
COPY scripts/check-node-version.mjs scripts/check-node-version.mjs
COPY packages/web/package.json packages/web/
COPY packages/shared-types/package.json packages/shared-types/
COPY packages/ui/package.json packages/ui/
COPY packages/backend/package.json packages/backend/
COPY packages/marketing/package.json packages/marketing/
COPY patches/ patches/
RUN pnpm install --frozen-lockfile

FROM build-deps AS build
COPY packages/shared-types packages/shared-types
COPY packages/ui packages/ui
COPY packages/web packages/web

ARG SLUGBASE_EDITION=ce
ENV SLUGBASE_EDITION=$SLUGBASE_EDITION

RUN pnpm exec turbo run build --filter=@slugbase/web...

RUN find packages/web/build -name '*.js.map' -delete

FROM build AS deploy
RUN pnpm deploy --filter=@slugbase/web --prod /prod/web

FROM base AS runtime
ENV NODE_ENV=production
ENV PORT=3000
WORKDIR /app
COPY --from=deploy /prod/web ./

RUN groupadd --system --gid 10001 slugbase \
  && useradd --system --uid 10001 --gid slugbase --home-dir /app --no-create-home slugbase \
  && chown -R slugbase:slugbase /app

USER slugbase
EXPOSE 3000
CMD ["node", "./node_modules/@react-router/serve/dist/cli.js", "./build/server/index.js"]
