{
  "name": "slugbase",
  "version": "0.0.0",
  "private": true,
  "description": "SlugBase Community Edition composition root",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "build": "tsc -p tsconfig.build.json && vite build",
    "dev:web": "vite"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@slugbase/adapters": "workspace:*",
    "@slugbase/contracts": "workspace:*",
    "@slugbase/core": "workspace:*",
    "@slugbase/db": "workspace:*",
    "@slugbase/email": "workspace:*",
    "@slugbase/server": "workspace:*",
    "@slugbase/ui": "workspace:*",
    "@slugbase/web": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@slugbase/testing": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}
