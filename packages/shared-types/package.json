{
  "name": "@slugbase/shared-types",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mdg-labs/slugbase.git",
    "directory": "packages/shared-types"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "openapi:generate": "pnpm build && node dist/scripts/generate-openapi.js",
    "test:unit": "vitest run",
    "test:integration": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@ts-rest/core": "^3.52.1",
    "@ts-rest/open-api": "^3.52.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^25.9.1"
  }
}
