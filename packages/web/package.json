{
  "name": "@slugbase/web",
  "version": "0.0.0",
  "private": true,
  "description": "The web app as a library",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint --max-warnings=0 .",
    "routes:generate": "tsr generate",
    "typecheck": "tsr generate && tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run --project unit",
    "build": "tsr generate && tsc -p tsconfig.build.json",
    "i18n:check": "node ../../scripts/check-i18n.mjs --require-catalogs .",
    "contracts:check": "node ../../tooling/api-report/api-report.ts check --package ."
  },
  "dependencies": {
    "@slugbase/contracts": "workspace:*",
    "@slugbase/ui": "workspace:*",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "i18next": "^26.4.4",
    "i18next-icu": "^2.5.0",
    "intl-messageformat": "^12.1.3",
    "openapi-fetch": "^0.17.0",
    "react-i18next": "^17.0.16"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@slugbase/testing": "workspace:*",
    "@tanstack/router-cli": "^1.167.43",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vitest-axe": "^0.1.0"
  }
}
