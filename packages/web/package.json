{
  "name": "@slugbase/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint app/",
    "typecheck": "react-router typegen && tsc --noEmit -p tsconfig.json",
    "build": "react-router build",
    "deploy": "wrangler deploy --config build/server/wrangler.json",
    "preview": "wrangler dev",
    "start": "react-router-serve ./build/server/index.js",
    "dev": "react-router dev",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@sentry/react": "^9.47.0",
    "@react-router/node": "^7.16.0",
    "@react-router/serve": "^7.16.0",
    "@slugbase/ui": "workspace:^",
    "@tolgee/react": "^7.1.0",
    "cmdk": "^1.1.1",
    "isbot": "^5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.16.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.12.2",
    "@sentry/vite-plugin": "^3.5.0",
    "@react-router/dev": "^7.16.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "happy-dom": "^20.9.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.17",
    "vite": "^6.4.2",
    "vitest": "^3.2.1",
    "wrangler": "^4.24.0"
  }
}
