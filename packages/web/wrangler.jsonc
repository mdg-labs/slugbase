{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "slugbase-staging-web",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./workers/app.ts",
  "routes": [
    {
      "pattern": "staging-cloud.slugbase.app",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
