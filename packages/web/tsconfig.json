{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDirs": [".", "./.react-router/types"],
    "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": ["app/**/*", "app/vite-env.d.ts", ".react-router/types/**/*"],
  "references": [{ "path": "../ui" }]
}
