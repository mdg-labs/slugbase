{
  "name": "@slugbase/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "eslint src/ test/ drizzle.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test:unit": "vitest run --config vitest.config.ts src",
    "test:integration": "vitest run --config vitest.config.ts test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "@react-router/express": "^7.16.0",
    "@slugbase/shared-types": "workspace:^",
    "@types/cookie-parser": "^1.4.10",
    "better-sqlite3": "^11.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.2",
    "nodemailer": "^8.0.10",
    "postgres": "^3.4.7",
    "react-router": "^7.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.1",
    "supertest": "^7.1.1"
  }
}
