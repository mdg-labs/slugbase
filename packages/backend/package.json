{
  "name": "@slugbase/backend",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "eslint src/ test/ drizzle.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "bash ../../scripts/run-backend-integration-tests.sh",
    "test:integration:run": "vitest run --config vitest.integration.config.ts --maxWorkers=1",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@mjackson/node-fetch-server": "0.2.0",
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@react-router/express": "^7.16.0",
    "@sentry/nestjs": "^10.58.0",
    "@slugbase/email-templates": "workspace:^",
    "@slugbase/shared-types": "workspace:^",
    "@types/cookie-parser": "^1.4.10",
    "argon2": "^0.44.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.2",
    "helmet": "^8.2.0",
    "nodemailer": "^9.0.1",
    "openid-client": "^6.8.4",
    "otplib": "^13.4.1",
    "postgres": "^3.4.7",
    "qrcode": "^1.5.4",
    "react-router": "^7.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "^18.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.1",
    "supertest": "^7.1.1"
  }
}
