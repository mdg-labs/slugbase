{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "slugbase-production-marketing",
  "compatibility_date": "2026-06-01",
  "routes": [
    {
      "pattern": "slugbase.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
