---
import "@slugbase/ui/styles/colors-and-type.css";
import "../styles/marketing.css";
import MarketingFooter from "../components/MarketingFooter.astro";
import MarketingNav from "../components/MarketingNav.astro";
import AnalyticsConsent from "../components/AnalyticsConsent.astro";
interface Props {
  title: string;
}

const { title } = Astro.props;
const locale = Astro.currentLocale;
const appOrigin = import.meta.env.PUBLIC_FRONTEND_ORIGIN ?? "";
---

<!doctype html>
<html lang={locale} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="SlugBase — keyboard-driven bookmark manager with slug forwarding." />
    <link rel="icon" type="image/svg+xml" href="/slugbase_icon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <MarketingNav appOrigin={appOrigin} />
    <main>
      <slot />
    </main>
    <MarketingFooter />
    <AnalyticsConsent />
  </body>
</html>
