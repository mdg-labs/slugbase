---
import { getRelativeLocaleUrl } from "astro:i18n";
import { t, type SupportedLocale } from "../i18n/tolgee.js";

const locale = Astro.currentLocale as SupportedLocale;
const year = new Date().getFullYear();
const homeHref = getRelativeLocaleUrl(locale, "/");
const pricingHref = getRelativeLocaleUrl(locale, "/pricing");
const contactHref = getRelativeLocaleUrl(locale, "/contact");
---

<footer class="mk-footer">
  <div class="mk-c">
    <div class="mk-footer-inner">
      <div>
        <div class="mk-footer-brand">
          <img src="/slugbase_icon.svg" width="22" height="22" alt="" />
          <span>{t(locale, "marketing.nav.brand")}</span>
        </div>
        <p class="mk-footer-tagline">{t(locale, "marketing.footer.tagline")}</p>
        <div class="mk-footer-gdpr-wrap">
          <div class="mk-footer-gdpr">
            <span class="mk-footer-gdpr-icon" aria-hidden="true">✓</span>
            <span>{t(locale, "marketing.footer.gdpr")}</span>
          </div>
        </div>
      </div>
      <div>
        <div class="mk-footer-col-head">{t(locale, "marketing.footer.product")}</div>
        <div class="mk-footer-links">
          <a class="mk-footer-link" href={`${homeHref}#features`}>{t(locale, "marketing.footer.features")}</a>
          <a class="mk-footer-link" href={pricingHref}>{t(locale, "marketing.footer.pricing")}</a>
          <a class="mk-footer-link" href={contactHref}>{t(locale, "marketing.footer.contact")}</a>
          <span class="mk-footer-link mk-footer-link--muted">{t(locale, "marketing.footer.docs")}</span>
        </div>
      </div>
      <div>
        <div class="mk-footer-col-head">{t(locale, "marketing.footer.legal")}</div>
        <div class="mk-footer-links">
          <span class="mk-footer-link mk-footer-link--muted">{t(locale, "marketing.footer.impressum")}</span>
          <span class="mk-footer-link mk-footer-link--muted">{t(locale, "marketing.footer.privacy")}</span>
          <span class="mk-footer-link mk-footer-link--muted">{t(locale, "marketing.footer.terms")}</span>
        </div>
      </div>
    </div>
    <div class="mk-footer-bottom">
      <span>{t(locale, "marketing.footer.copyright", { year: String(year) })}</span>
      <span class="mk-oss">{t(locale, "marketing.footer.oss")}</span>
    </div>
  </div>
</footer>

<style>
  .mk-footer-brand {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    margin-bottom: var(--sp-5);
  }

  .mk-footer-brand span {
    font-weight: var(--weight-semi);
    font-size: 15px;
    color: var(--fg);
  }

  .mk-footer-tagline {
    margin: 0;
    font-size: 14px;
    color: var(--fg-subtle);
    line-height: 1.6;
    max-width: 260px;
  }

  .mk-footer-gdpr-wrap {
    margin-top: var(--sp-6);
  }

  .mk-footer-gdpr-icon {
    color: var(--success-text);
    font-weight: var(--weight-semi);
  }

  .mk-footer-link--muted {
    cursor: default;
  }
</style>
