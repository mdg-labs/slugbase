---
import LandingSections from "./LandingSections.astro";
import MarketingLayout from "../layouts/MarketingLayout.astro";
import { formatMarketingBrandTitle } from "../i18n/format-marketing-page-title.js";
import type { SupportedLocale } from "../i18n/translate.js";

const locale = Astro.currentLocale as SupportedLocale;
const appOrigin = import.meta.env.PUBLIC_FRONTEND_ORIGIN ?? "";
const title = formatMarketingBrandTitle(locale);
---

<MarketingLayout title={title}>
  <LandingSections appOrigin={appOrigin} />
</MarketingLayout>

<script>
  import { initLivePricing } from "../lib/pricing-hydrate.client.ts";

  void initLivePricing();
</script>
