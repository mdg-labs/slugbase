---
import { t, type SupportedLocale } from "../i18n/translate.js";
import {
  isSupporterPromotionActive,
  loadMarketingPricingConfig,
} from "../lib/pricing-config.js";

interface Props {
  appOrigin: string;
}

const { appOrigin } = Astro.props;
const locale = Astro.currentLocale as SupportedLocale;
const getStartedHref = appOrigin ? `${appOrigin}/auth/register` : "#";
const pricingHref =
  locale === "de" ? "/de/pricing" : "/pricing";

const forwardingDomain =
  import.meta.env.PUBLIC_FORWARDING_DOMAIN || "cloud.slugbase.app";

const pricingConfig = await loadMarketingPricingConfig();
const freeBookmarkCap = String(pricingConfig.freeBookmarkCap);
const supporterActive = isSupporterPromotionActive(pricingConfig);

const features = [
  {
    titleKey: "marketing.landing.feature_folders_title" as const,
    descKey: "marketing.landing.feature_folders_desc" as const,
    icon: "folder",
  },
  {
    titleKey: "marketing.landing.feature_tags_title" as const,
    descKey: "marketing.landing.feature_tags_desc" as const,
    icon: "hash",
  },
  {
    titleKey: "marketing.landing.feature_pinned_title" as const,
    descKey: "marketing.landing.feature_pinned_desc" as const,
    icon: "pin",
  },
  {
    titleKey: "marketing.landing.feature_sharing_title" as const,
    descKey: "marketing.landing.feature_sharing_desc" as const,
    icon: "share-2",
  },
];

const slugChecks = [
  "marketing.landing.slug_check_1" as const,
  "marketing.landing.slug_check_2" as const,
  "marketing.landing.slug_check_3" as const,
];

const cmdChecks = [
  "marketing.landing.cmd_check_1" as const,
  "marketing.landing.cmd_check_2" as const,
  "marketing.landing.cmd_check_3" as const,
  "marketing.landing.cmd_check_4" as const,
];

const teamChecks = [
  "marketing.landing.team_check_1" as const,
  "marketing.landing.team_check_2" as const,
  "marketing.landing.team_check_3" as const,
  "marketing.landing.team_check_4" as const,
];

const selfhostChecks = [
  "marketing.landing.selfhost_check_1" as const,
  "marketing.landing.selfhost_check_2" as const,
  "marketing.landing.selfhost_check_3" as const,
  "marketing.landing.selfhost_check_4" as const,
];

interface TeamFolder {
  nameKey: "marketing.landing.team_folder_dev" | "marketing.landing.team_folder_design" | "marketing.landing.team_folder_inbox";
  color: string;
  count: number;
  sharingKey: "marketing.landing.team_sharing_team" | "marketing.landing.team_sharing_members" | "marketing.landing.team_sharing_private";
  sharingParams?: Record<string, string>;
  isPrivate: boolean;
}

const teamFolders: TeamFolder[] = [
  { nameKey: "marketing.landing.team_folder_dev", color: "var(--success)", count: 9, sharingKey: "marketing.landing.team_sharing_team", isPrivate: false },
  { nameKey: "marketing.landing.team_folder_design", color: "var(--danger)", count: 5, sharingKey: "marketing.landing.team_sharing_members", sharingParams: { names: "Sarah K., Tom R." }, isPrivate: false },
  { nameKey: "marketing.landing.team_folder_inbox", color: "var(--accent-text)", count: 6, sharingKey: "marketing.landing.team_sharing_private", isPrivate: true },
];

/** Extract the currency prefix from a formatted price string. */
function extractCurrencyPrefix(price: string): string {
  const match = price.match(/^([^\d]*)/);
  return match?.[1]?.trimEnd() ?? "";
}

const personalMonthlyPrice = pricingConfig.personalMonthlyPrice || "—";
const teamSeatMonthlyPrice = pricingConfig.teamSeatMonthlyPrice || "—";
const freeCurrency = extractCurrencyPrefix(pricingConfig.personalMonthlyPrice || "");
const freePrice = freeCurrency ? `${freeCurrency}0` : "—";
---

<!-- ---- Hero ---- -->
<section class="mk-hero">
  <div class="mk-c">
    <div class="mk-hero-tag">{t(locale, "marketing.landing.hero_tag")}</div>
    <h1 class="mk-h1">
      {t(locale, "marketing.landing.hero_title")}<br />
      <span class="mk-accent">{t(locale, "marketing.landing.hero_title_accent")}</span>
    </h1>
    <p class="mk-hero-sub">{t(locale, "marketing.landing.hero_subtitle")}</p>
    <div class="mk-hero-ctas">
      <a class="mk-btn mk-btn--primary mk-btn--lg" href={getStartedHref}>
        {t(locale, "marketing.landing.cta_primary")}
      </a>
      <a class="mk-btn mk-btn--secondary mk-btn--lg" href="#self-host">
        {t(locale, "marketing.landing.cta_secondary")}
      </a>
    </div>
    <!-- Static palette demo (34.1.3) — CSS-driven; shows go-mode resolved state -->
    <div class="hero-pal-wrap" aria-hidden="true">
      <div class="hero-pal">
        <div class="hero-pal-input">
          <span class="hero-pal-mode">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            go
          </span>
          <span class="hero-pal-query">go react19<span class="cursor"></span></span>
          <kbd class="mk-kbd">Esc</kbd>
        </div>
        <div class="hero-pal-list">
          <div class="hero-pal-section-label">{t(locale, "marketing.landing.palette_label_slugs")}</div>
          <div class="hero-pal-item active">
            <span class="hero-pal-item-icon">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            </span>
            <span class="hero-pal-slug">{forwardingDomain}/react19</span>
            <svg class="hero-pal-arrow" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            <span class="hero-pal-dest">react.dev/blog/2024/04/25/react-19</span>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--fg-faint);flex:none"><polyline points="9 10 4 15 9 20"/><path d="M20 4v7a4 4 0 0 1-4 4H4"/></svg>
          </div>
          <div class="hero-pal-item">
            <span class="hero-pal-item-icon hero-pal-item-icon--dim">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            </span>
            <span class="hero-pal-slug">{forwardingDomain}/react-conf</span>
            <svg class="hero-pal-arrow" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            <span class="hero-pal-dest">react.dev/conf</span>
          </div>
        </div>
        <div class="hero-pal-foot">
          <span><kbd class="mk-kbd">↑</kbd><kbd class="mk-kbd">↓</kbd> {t(locale, "marketing.landing.palette_navigate")}</span>
          <span><kbd class="mk-kbd">↵</kbd> {t(locale, "marketing.landing.palette_redirect")}</span>
          <span class="hero-pal-brand">
            <img src="/slugbase_icon.svg" width="13" height="13" alt="" />SlugBase
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ---- Slug forwarding ---- -->
<section class="mk-section mk-section--alt">
  <div class="mk-c">
    <div class="mk-split">
      <div class="mk-split-text">
        <span class="mk-eyebrow">{t(locale, "marketing.landing.slug_eyebrow")}</span>
        <h2 class="mk-h2">{t(locale, "marketing.landing.slug_title")}</h2>
        <p>{t(locale, "marketing.landing.slug_body")}</p>
        <ul class="mk-list-check">
          {slugChecks.map((key) => (
            <li>
              <span class="mk-check" aria-hidden="true">✓</span>
              {t(locale, key)}
            </li>
          ))}
        </ul>
      </div>
      <div class="mk-browser" aria-hidden="true">
        <div class="mk-browser-chrome">
          <div class="mk-browser-dots">
            <div class="mk-browser-dot" style="background: var(--danger, #f0686b)"></div>
            <div class="mk-browser-dot" style="background: var(--warning, #e6b24e)"></div>
            <div class="mk-browser-dot" style="background: var(--success)"></div>
          </div>
          <div class="mk-url-bar">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            <span>{forwardingDomain}/<span class="slug-part">react19</span></span>
          </div>
        </div>
        <div class="mk-url-redirect">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--success-text);flex:none"><polyline points="20 6 9 17 4 12"/></svg>
          <span style="color:var(--success-text)">→ <strong style="font-family:var(--font-mono);color:var(--accent-text)">react.dev/blog/react-19</strong></span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ---- Bookmark manager features ---- -->
<section class="mk-section" id="features">
  <div class="mk-c">
    <div class="mk-section-head">
      <span class="mk-eyebrow">{t(locale, "marketing.landing.features_eyebrow")}</span>
      <h2 class="mk-h2">{t(locale, "marketing.landing.features_title")}</h2>
      <p class="mk-body">{t(locale, "marketing.landing.features_body")}</p>
    </div>
    <div class="mk-features">
      {features.map(({ titleKey, descKey, icon }) => (
        <article class="mk-feat">
          <div class="mk-feat-icon" aria-hidden="true">
            {icon === "folder" && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
            )}
            {icon === "hash" && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="9" x2="20" y2="9"/><line x1="4" y1="15" x2="20" y2="15"/><line x1="10" y1="3" x2="8" y2="21"/><line x1="16" y1="3" x2="14" y2="21"/></svg>
            )}
            {icon === "pin" && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="17" x2="12" y2="22"/><path d="M5 17h14v-1.76a2 2 0 0 0-1.11-1.79l-1.78-.9A2 2 0 0 1 15 10.76V6h1a2 2 0 0 0 0-4H8a2 2 0 0 0 0 4h1v4.76a2 2 0 0 1-1.11 1.79l-1.78.9A2 2 0 0 0 5 15.24z"/></svg>
            )}
            {icon === "share-2" && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            )}
          </div>
          <h3>{t(locale, titleKey)}</h3>
          <p>{t(locale, descKey)}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ---- Command palette section (34.4) ---- -->
<section class="mk-section mk-section--alt">
  <div class="mk-c">
    <div class="mk-split mk-split--rev">
      <div class="mk-split-text">
        <span class="mk-eyebrow">{t(locale, "marketing.landing.cmd_eyebrow")}</span>
        <h2 class="mk-h2">{t(locale, "marketing.landing.cmd_title")}</h2>
        <p>{t(locale, "marketing.landing.cmd_body")}</p>
        <ul class="mk-list-check">
          {cmdChecks.map((key) => (
            <li>
              <span class="mk-check" aria-hidden="true">✓</span>
              {t(locale, key)}
            </li>
          ))}
        </ul>
      </div>
      <div class="mk-code" aria-hidden="true">
        <div class="mk-code-header">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
          {t(locale, "marketing.landing.cmd_terminal_label")}
        </div>
        <div class="mk-code-lines">
          <div><span class="cmd">❯</span> <span class="slug-c">go react19</span></div>
          <div class="mk-code-indent">→ react.dev/blog/2024/04/25/react-19</div>
          <div class="mk-code-gap"><span class="cmd">❯</span> <span class="mk-code-muted">designing data</span></div>
          <div class="mk-code-indent">Designing Data-Intensive Applications — notes</div>
          <div class="mk-code-indent">{forwardingDomain}/ddia</div>
          <div class="mk-code-gap"><span class="cmd">❯</span> <span class="mk-code-muted">new bookmark</span> <span class="mk-code-faint">C</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ---- Team sharing section (34.5) ---- -->
<section class="mk-section">
  <div class="mk-c">
    <div class="mk-split">
      <div class="mk-split-text">
        <span class="mk-eyebrow">{t(locale, "marketing.landing.team_eyebrow")}</span>
        <h2 class="mk-h2">{t(locale, "marketing.landing.team_title")}</h2>
        <p>{t(locale, "marketing.landing.team_body")}</p>
        <ul class="mk-list-check">
          {teamChecks.map((key) => (
            <li>
              <span class="mk-check" aria-hidden="true">✓</span>
              {t(locale, key)}
            </li>
          ))}
        </ul>
      </div>
      <div class="mk-folder-list" aria-hidden="true">
        {teamFolders.map((folder) => (
          <div class="mk-folder-row">
            <span class="mk-folder-dot" style={`background: ${folder.color}`}></span>
            <span class="mk-folder-name">{t(locale, folder.nameKey)}</span>
            <span class="mk-folder-count">
              {t(locale, "marketing.landing.team_folder_bookmarks_suffix", { count: String(folder.count) })}
            </span>
            <span class={`mk-folder-sharing ${folder.isPrivate ? "mk-folder-sharing--private" : "mk-folder-sharing--shared"}`}>
              {folder.isPrivate ? (
                <>
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                  {t(locale, folder.sharingKey)}
                </>
              ) : (
                <>
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                  {folder.sharingParams
                    ? t(locale, folder.sharingKey, folder.sharingParams)
                    : t(locale, folder.sharingKey)}
                </>
              )}
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ---- Self-hosted Docker section (34.6) ---- -->
<section class="mk-section mk-section--alt" id="self-host">
  <div class="mk-c">
    <div class="mk-split">
      <div class="mk-split-text">
        <span class="mk-eyebrow">{t(locale, "marketing.landing.selfhost_eyebrow")}</span>
        <h2 class="mk-h2">{t(locale, "marketing.landing.selfhost_title")}</h2>
        <p>{t(locale, "marketing.landing.selfhost_body")}</p>
        <ul class="mk-list-check">
          {selfhostChecks.map((key) => (
            <li>
              <span class="mk-check" aria-hidden="true">✓</span>
              {t(locale, key)}
            </li>
          ))}
        </ul>
        <div class="mk-split-actions">
          <a class="mk-btn mk-btn--secondary mk-btn--sm" href="https://github.com/slugbase/slugbase" target="_blank" rel="noopener noreferrer">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
            {t(locale, "marketing.landing.selfhost_github")}
          </a>
          <a class="mk-btn mk-btn--ghost mk-btn--sm" href="#" aria-disabled="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            {t(locale, "marketing.landing.selfhost_docs")}
          </a>
        </div>
      </div>
      <div class="mk-code" aria-hidden="true">
        <div class="mk-code-header">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
          {t(locale, "marketing.landing.selfhost_terminal_label")}
        </div>
        <div class="mk-code-lines">
          <div><span class="cmd">docker run \</span></div>
          <div class="mk-code-indent-sm">-p 3000:3000 \</div>
          <div class="mk-code-indent-sm">-v slugbase_data:/app/data \</div>
          <div class="mk-code-indent-sm">-e APP_BASE_URL=https://go.yourcompany.com \</div>
          <div class="mk-code-indent-sm"><span class="slug-c">ghcr.io/slugbase/slugbase:latest</span></div>
          <div class="mk-code-comment">{t(locale, "marketing.landing.selfhost_comment_1")}</div>
          <div class="mk-code-comment">{t(locale, "marketing.landing.selfhost_comment_2")}</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ---- Pricing teaser (34.7) ---- -->
<section class="mk-section">
  <div class="mk-c">
    <div class="mk-section-head">
      <span class="mk-eyebrow">{t(locale, "marketing.landing.pricing_eyebrow")}</span>
      <h2 class="mk-h2">{t(locale, "marketing.landing.pricing_title")}</h2>
      <p class="mk-body">{t(locale, "marketing.landing.pricing_body")}</p>
    </div>
    <div class="mk-teaser-plans">
      <!-- Free -->
      <div class="mk-teaser-plan">
        <div class="mk-teaser-plan-header">
          <span class="mk-teaser-plan-name">{t(locale, "marketing.pricing.plan.free")}</span>
        </div>
        <div class="mk-teaser-plan-price">{freePrice}</div>
        <ul class="mk-plan-feats">
          <li>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            {t(locale, "marketing.pricing.plan.free_feat_1", { cap: freeBookmarkCap })}
          </li>
          <li>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            {t(locale, "marketing.pricing.plan.free_feat_2")}
          </li>
          <li>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            {t(locale, "marketing.pricing.plan.free_feat_3")}
          </li>
          <li>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            {t(locale, "marketing.pricing.plan.free_feat_4")}
          </li>
        </ul>
        <a class="mk-btn mk-btn--secondary mk-btn--sm mk-teaser-cta" href={getStartedHref}>
          {t(locale, "marketing.pricing.cta.free")}
        </a>
      </div>
      <!-- Personal (featured) -->
      <div class="mk-teaser-plan mk-teaser-plan--featured">
        <div class="mk-teaser-plan-header">
          <span class="mk-teaser-plan-name">{t(locale, "marketing.pricing.plan.personal")}</span>
          <span class="mk-teaser-popular">{t(locale, "marketing.landing.pricing_popular")}</span>
        </div>
        <div class="mk-teaser-plan-price">
