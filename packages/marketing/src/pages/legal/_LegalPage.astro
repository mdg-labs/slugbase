---
import { getRelativeLocaleUrl } from "astro:i18n";
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import { renderLegalHtml, type LegalTab } from "../../legal/load-legal-markdown.js";
import { t, type MessageKey, type SupportedLocale } from "../../i18n/translate.js";

export type { LegalTab };

interface Props {
  tab: LegalTab;
}

const { tab } = Astro.props;
const locale = Astro.currentLocale as SupportedLocale;

const tabs: LegalTab[] = ["impressum", "agb", "datenschutz"];

const titleKeys: Record<LegalTab, MessageKey> = {
  impressum: "marketing.legal.impressum.title",
  agb: "marketing.legal.agb.title",
  datenschutz: "marketing.legal.datenschutz.title",
};

const pageTitle = `${t(locale, titleKeys[tab])} - ${t(locale, "marketing.nav.brand")}`;
const legalHtml = renderLegalHtml(tab, locale);
---

<MarketingLayout title={pageTitle}>
  <section class="mk-section">
    <div class="mk-c--narrow">
      <nav class="mk-legal-tabs" aria-label={t(locale, "marketing.footer.legal")}>
        {tabs.map((item) => {
          const href = getRelativeLocaleUrl(locale, `/legal/${item}`);
          const isActive = item === tab;
          return (
            <a
              class:list={["mk-legal-tab", { active: isActive }]}
              href={href}
              aria-current={isActive ? "page" : undefined}
            >
              {t(locale, titleKeys[item])}
            </a>
          );
        })}
      </nav>

      <h1 class="mk-legal-page-title">{t(locale, titleKeys[tab])}</h1>

      <div class="mk-legal-prose" data-testid="legal-content" set:html={legalHtml} />
    </div>
  </section>
</MarketingLayout>

<style>
  .mk-legal-page-title {
    margin: 0 0 var(--sp-9);
    font: 700 clamp(28px, 4vw, 36px) / 1.15 var(--font-sans);
    letter-spacing: -0.025em;
    color: var(--fg);
  }

  .mk-legal-tab {
    text-decoration: none;
  }
</style>
