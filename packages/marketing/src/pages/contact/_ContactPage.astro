---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
import {
  CONTACT_TOPICS,
  isContactFormConfigured,
  loadMarketingContactConfig,
} from "../../lib/contact-config.js";
import { t, type MessageKey, type SupportedLocale } from "../../i18n/translate.js";
import type { ContactTopic } from "../../lib/contact-config.js";

const locale = Astro.currentLocale as SupportedLocale;
const config = loadMarketingContactConfig();
const formReady = isContactFormConfigured(config);
const title = `${t(locale, "marketing.contact.page_title")} - ${t(locale, "marketing.nav.brand")}`;

const clientMessages = {
  errorGeneric: t(locale, "marketing.contact.error.generic"),
  errorValidation: t(locale, "marketing.contact.error.validation"),
  errorRateLimit: t(locale, "marketing.contact.error.rate_limit"),
  errorUnavailable: t(locale, "marketing.contact.error.unavailable"),
  errorChallenge: t(locale, "marketing.contact.error.challenge"),
};

const successBodyParts = t(locale, "marketing.contact.success_body").split("{email}");

const topicLabelKeys: Record<ContactTopic, MessageKey> = {
  general: "marketing.contact.topic.general",
  support: "marketing.contact.topic.support",
  business: "marketing.contact.topic.business",
  press: "marketing.contact.topic.press",
  selfhost: "marketing.contact.topic.selfhost",
};

const topicOptions = CONTACT_TOPICS.map((topic) => ({
  value: topic,
  label: t(locale, topicLabelKeys[topic]),
}));
---

<MarketingLayout title={title}>
  <section
    class="mk-section"
    id="contact-form-root"
    data-error-generic={clientMessages.errorGeneric}
    data-error-validation={clientMessages.errorValidation}
    data-error-rate-limit={clientMessages.errorRateLimit}
    data-error-unavailable={clientMessages.errorUnavailable}
    data-error-challenge={clientMessages.errorChallenge}
    data-contact-endpoint={config.contactEndpoint}
    data-turnstile-site-key={config.turnstileSiteKey}
    data-name-max-length={String(config.nameMaxLength)}
    data-message-max-length={String(config.messageMaxLength)}
  >
    <div class="mk-c">
      <div class="mk-contact-grid">
        <div>
          <span class="mk-eyebrow">{t(locale, "marketing.contact.eyebrow")}</span>
          <h1 class="mk-h2 mk-contact-headline">{t(locale, "marketing.contact.headline")}</h1>
          <p class="mk-body mk-contact-subhead">{t(locale, "marketing.contact.subheadline")}</p>

          {!formReady && (
            <p class="mk-contact-unconfigured" role="status">
              {t(locale, "marketing.contact.unconfigured")}
            </p>
          )}

          <div id="contact-error" class="mk-contact-error" role="alert" hidden data-testid="contact-error" />

          <form id="contact-form" class="mk-form" novalidate hidden={!formReady} data-testid="contact-form">
            <div class="mk-contact-field-row">
              <div class="mk-field">
                <label for="contact-name">{t(locale, "marketing.contact.field.name")}</label>
                <input
                  id="contact-name"
                  class="mk-input"
                  type="text"
                  name="name"
                  autocomplete="name"
                  maxlength={config.nameMaxLength}
                  placeholder={t(locale, "marketing.contact.placeholder.name")}
                  required
                  data-testid="contact-name-input"
                />
              </div>
              <div class="mk-field">
                <label for="contact-email">{t(locale, "marketing.contact.field.email")}</label>
                <input
                  id="contact-email"
                  class="mk-input"
                  type="email"
                  name="email"
                  autocomplete="email"
                  placeholder={t(locale, "marketing.contact.placeholder.email")}
                  required
                  data-testid="contact-email-input"
                />
              </div>
            </div>
            <div class="mk-field">
              <label for="contact-topic">{t(locale, "marketing.contact.field.topic")}</label>
              <select id="contact-topic" class="mk-input mk-select" name="topic" required>
                {topicOptions.map((option) => (
                  <option value={option.value}>{option.label}</option>
                ))}
              </select>
            </div>
            <div class="mk-field">
              <label for="contact-message">{t(locale, "marketing.contact.field.message")}</label>
<textarea
                  id="contact-message"
                  class="mk-input mk-textarea"
                  name="message"
                  maxlength={config.messageMaxLength}
                  placeholder={t(locale, "marketing.contact.placeholder.message")}
                  required
                  data-testid="contact-message-input"
                />
            </div>
            <div
              id="contact-turnstile"
              class="contact-turnstile-mount"
              hidden={config.turnstileSiteKey.length === 0}
            />
            <button id="contact-submit" type="submit" class="mk-btn mk-btn--primary" disabled data-testid="contact-submit-btn">
              {t(locale, "marketing.contact.submit")}
            </button>
          </form>

          <div id="contact-success" class="mk-success" hidden data-testid="contact-success">
            <div class="mk-success-ic" aria-hidden="true">✓</div>
            <h2 class="mk-h2 mk-contact-success-title">{t(locale, "marketing.contact.success_title")}</h2>
            <p class="mk-body mk-contact-success-body">
              {successBodyParts[0]}
              <strong id="contact-success-email" class="mk-contact-success-email" />
              {successBodyParts[1]}
            </p>
            <button id="contact-send-another" type="button" class="mk-btn mk-btn--secondary">
              {t(locale, "marketing.contact.success_another")}
            </button>
          </div>
        </div>

        <aside class="mk-contact-aside">
          <div class="mk-contact-card">
            <h2 class="mk-contact-card-title">{t(locale, "marketing.contact.sidebar.alt_title")}</h2>
            <p class="mk-contact-card-body">{t(locale, "marketing.contact.sidebar.alt_body")}</p>
            <span class="mk-mono-pill">{t(locale, "marketing.contact.sidebar.support_email")}</span>
          </div>
          <div class="mk-contact-card">
            <h2 class="mk-contact-card-title">{t(locale, "marketing.contact.sidebar.selfhost_title")}</h2>
            <p class="mk-contact-card-body">{t(locale, "marketing.contact.sidebar.selfhost_body")}</p>
            <ul class="mk-contact-channel-list">
              <li>{t(locale, "marketing.contact.sidebar.selfhost_bugs")}</li>
              <li>{t(locale, "marketing.contact.sidebar.selfhost_discussions")}</li>
            </ul>
          </div>
        </aside>
      </div>
    </div>
  </section>
</MarketingLayout>

<script>
  import { initContactForm } from "../../lib/contact-form.client.ts";

  const root = document.getElementById("contact-form-root");
  if (root) {
    initContactForm({
      contactEndpoint: root.dataset.contactEndpoint ?? "",
      turnstileSiteKey: root.dataset.turnstileSiteKey ?? "",
      nameMaxLength: Number.parseInt(root.dataset.nameMaxLength ?? "200", 10),
      messageMaxLength: Number.parseInt(root.dataset.messageMaxLength ?? "5000", 10),
      messages: {
        errorGeneric: root.dataset.errorGeneric ?? "",
        errorValidation: root.dataset.errorValidation ?? "",
        errorRateLimit: root.dataset.errorRateLimit ?? "",
        errorUnavailable: root.dataset.errorUnavailable ?? "",
        errorChallenge: root.dataset.errorChallenge ?? "",
      },
    });
  }
</script>

<style>
  .mk-contact-headline {
    margin-bottom: var(--sp-5);
  }

  .mk-contact-subhead {
    margin-bottom: var(--sp-8);
  }

  .mk-contact-field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-5);
  }

  .mk-contact-aside {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    padding-top: var(--sp-10);
  }

  .mk-contact-card {
    background: var(--raised);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-xl);
    padding: var(--sp-7);
  }

  .mk-contact-card-title {
    margin: 0 0 var(--sp-4);
    font-weight: var(--weight-semi);
    font-size: 16px;
    color: var(--fg);
  }

  .mk-contact-card-body {
    margin: 0 0 var(--sp-4);
    font-size: 15px;
    color: var(--fg-muted);
    line-height: 1.6;
  }

  .mk-contact-channel-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    font-size: 14px;
    color: var(--fg-muted);
  }

  .mk-contact-error {
    margin-bottom: var(--sp-5);
    padding: var(--sp-4) var(--sp-5);
    border-radius: var(--r-md);
    background: var(--danger-subtle);
    border: 1px solid rgba(240, 104, 107, 0.35);
    color: var(--danger-text);
    font-size: var(--text-body);
  }

  .mk-contact-unconfigured {
    margin: 0 0 var(--sp-6);
    font-size: var(--text-body);
    color: var(--fg-muted);
  }

  .contact-turnstile-mount {
    min-height: 64px;
  }

  .mk-contact-success-title {
    margin: 0;
  }

  .mk-contact-success-body {
    max-width: 360px;
    text-align: center;
  }

  .mk-contact-success-email {
    color: var(--fg);
  }

  @media (max-width: 900px) {
    .mk-contact-field-row {
      grid-template-columns: 1fr;
    }

    .mk-contact-aside {
      padding-top: 0;
    }
  }
</style>
