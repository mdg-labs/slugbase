---
import { getCollection } from "astro:content";
import {
  filterByLocale,
  filterPublished,
  sortPostsByDate,
} from "@mdg-labs/blog";
import PostList from "@mdg-labs/blog/layouts/PostList.astro";
import MarketingLayout from "../../../layouts/MarketingLayout.astro";
import { resolveBlogIndexAlternateHref } from "../../../lib/blog-locale-nav.js";
import { formatMarketingPageTitle } from "../../../i18n/format-marketing-page-title.js";
import { t } from "../../../i18n/translate.js";
import "../../../styles/blog.css";

export const prerender = true;

const locale = "de";
const posts = sortPostsByDate(
  filterByLocale(filterPublished(await getCollection("blog")), locale),
);

const title = formatMarketingPageTitle(locale, "marketing.blog.page_title");
const localeAlternateHref = resolveBlogIndexAlternateHref(locale);
---

<MarketingLayout title={title} localeAlternateHref={localeAlternateHref}>
  <div class="mk-c blog-index">
    <header>
      <span class="mk-eyebrow">{t(locale, "marketing.blog.page_title")}</span>
      <h1 class="mk-h2">{t(locale, "marketing.blog.index_headline")}</h1>
      <p class="mk-body">{t(locale, "marketing.blog.index_description")}</p>
    </header>
    <PostList posts={posts} basePath="/de/blog" />
  </div>
</MarketingLayout>
