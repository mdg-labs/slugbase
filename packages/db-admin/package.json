{
  "name": "@slugbase/db-admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "default": "./dist/schema/index.js"
    },
    "./public-read": {
      "types": "./dist/public-read/index.d.ts",
      "default": "./dist/public-read/index.js"
    },
    "./public-read/queries": {
      "types": "./dist/public-read/overview-queries.d.ts",
      "default": "./dist/public-read/overview-queries.js"
    }
  },
  "scripts": {
    "lint": "eslint src/ drizzle.config.ts vitest.config.ts vitest.integration.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "bash scripts/run-integration-tests.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "drizzle-kit": "^0.31.1"
  }
}
