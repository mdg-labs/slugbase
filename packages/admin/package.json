{
  "name": "@slugbase/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint src/ web/src/ vitest.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "build": "vite build --config web/vite.config.ts && tsc -p tsconfig.json",
    "dev": "concurrently -k -n vite,server -c cyan,magenta \"vite --config web/vite.config.ts\" \"tsx watch src/server.ts\"",
    "start": "node dist/server.js",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "bash scripts/run-integration-tests.sh"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@sentry/node": "^10.58.0",
    "@slugbase/db-admin": "workspace:^",
    "argon2": "^0.44.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.8.3",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.1",
    "postgres": "^3.4.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@testing-library/react": "^16.3.2",
    "happy-dom": "^20.0.10",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^7.16.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "8.0.16",
    "vitest": "4.1.6"
  }
}
