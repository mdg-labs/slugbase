{
  "name": "@slugbase/db",
  "version": "0.0.0",
  "private": true,
  "description": "Drizzle schema, migrations, row-level security and repositories",
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "node scripts/generate-migration.ts",
    "db:migrate": "node scripts/migrate.ts",
    "contracts:check": "node ../../tooling/api-report/api-report.ts check --package ."
  },
  "dependencies": {
    "@slugbase/contracts": "workspace:*",
    "@slugbase/core": "workspace:*",
    "drizzle-orm": "0.45.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@slugbase/testing": "workspace:*",
    "drizzle-kit": "0.31.11"
  }
}
