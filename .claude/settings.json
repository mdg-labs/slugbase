{
  "permissions": {
    "allow": [
      "Bash(git commit:*)",
      "Bash(git push origin dev)",
      "Bash(.claude/scripts/gh-rest.sh:*)",
      "Bash(.claude/scripts/issue-status.sh:*)",
      "Bash(.claude/scripts/epic-status.sh:*)",
      "Bash(.claude/scripts/issue-readiness.sh:*)",
      "Bash(.claude/scripts/security-history.sh:*)",
      "Bash(.claude/skills/dev-diff/dev-diff.sh:*)",
      "Bash(pnpm gate)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm turbo run:*)",
      "Bash(pnpm i18n:check)",
      "Bash(actionlint:*)",
      "Bash(shellcheck:*)",
      "Bash(.claude/scripts/security-route.sh:*)",
      "Bash(.claude/scripts/act-run.sh:*)",
      "Bash(.claude/scripts/gh-helpers.sh:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh search issues:*)",
      "Bash(gh label list:*)",
      "Bash(gh repo view:*)",
      "Bash(coderabbit auth status)",
      "Bash(timeout 30 coderabbit auth status)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git add -A:*)",
      "Bash(git add --all:*)",
      "Bash(git add .)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/scripts/guard-maintainer-labels.sh"
          }
        ]
      }
    ]
  }
}
