{
  "name": "slugbase",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "build": "turbo run build",
    "i18n:codegen": "node scripts/i18n-codegen-keys.mjs",
    "i18n:merge": "node scripts/i18n-merge-local-catalog.mjs",
    "i18n:push": "node scripts/i18n-push.mjs",
    "i18n:pull": "node scripts/i18n-pull.mjs",
    "i18n:check:hardcoded": "bash scripts/check-hardcoded-ui-strings.sh",
    "i18n:check:tolgee": "bash scripts/tolgee-pull-check.sh",
    "i18n:extract:check": "tolgee extract check --patterns packages/web/app/**/*.tsx",
    "i18n:compare:web": "tolgee compare --patterns packages/web/app/**/*.tsx",
    "test:scripts": "vitest run --config vitest.scripts.config.ts",
    "db:generate": "pnpm --filter @slugbase/backend db:generate",
    "db:migrate": "pnpm --filter @slugbase/backend db:migrate"
  },
  "devDependencies": {
    "@tolgee/cli": "^2.16.1",
    "@eslint/js": "^9.28.0",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^3.2.1"
  }
}
