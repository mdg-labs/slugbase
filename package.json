{
  "name": "slugbase-workspace",
  "private": true,
  "description": "SlugBase Community Edition workspace root",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.2.0 <25.0.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm lint:forbidden-terms && pnpm lint:external-hosts && pnpm lint:workflow-triggers",
    "lint:forbidden-terms": "bash scripts/check-forbidden-terms.test.sh && bash scripts/check-forbidden-terms.sh",
    "lint:external-hosts": "bash scripts/check-external-hosts.test.sh && bash scripts/check-external-hosts.sh",
    "lint:workflow-triggers": "bash scripts/check-workflow-triggers.test.sh && bash scripts/check-workflow-triggers.sh",
    "typecheck": "turbo run typecheck",
    "test:unit": "turbo run test:unit",
    "test:integration": "sh -c 'turbo run test:integration \"$@\" && pnpm --filter @slugbase/db run test:integration:quiet' sh",
    "contracts:check": "turbo run contracts:check --continue",
    "db:check": "turbo run db:check",
    "i18n:check": "turbo run i18n:check",
    "test:e2e": "pnpm --filter @slugbase/e2e test:e2e",
    "audit": "pnpm audit --audit-level=high",
    "gate": "pnpm lint && turbo run typecheck test:unit build && pnpm contracts:check && pnpm db:check && pnpm test:integration && pnpm i18n:check && pnpm audit --audit-level=high",
    "db:generate": "pnpm --filter @slugbase/db db:generate",
    "db:migrate": "pnpm --filter @slugbase/db db:migrate",
    "db:seed": "turbo run build --filter=@slugbase/core... && pnpm --filter @slugbase/testing db:seed",
    "api:gen": "pnpm --filter @slugbase/contracts api:gen",
    "api:extract": "turbo run build && node tooling/api-report/api-report.ts extract",
    "dev:services": "docker compose -f compose.dev.yml up -d --wait",
    "dev:services:down": "docker compose -f compose.dev.yml down",
    "dev": "turbo run dev:server dev:worker dev:web",
    "dev:web": "pnpm --filter slugbase dev:web",
    "dev:env": "node scripts/dev-env.mjs",
    "ui:ladle": "pnpm --filter @slugbase/ui ladle"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@formatjs/icu-messageformat-parser": "^3.5.21",
    "@microsoft/api-extractor": "^7.59.4",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-plugin-i18next": "^6.1.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm"
      ]
    },
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "^0.25.0",
      "@ai-sdk/provider-utils": "^4.0.33"
    },
    "patchedDependencies": {
      "postgres@3.4.9": "patches/postgres@3.4.9.patch"
    }
  }
}
