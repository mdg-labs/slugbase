{
  "name": "slugbase-workspace",
  "private": true,
  "description": "SlugBase Community Edition workspace root",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.2.0 <25.0.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-node.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm lint:forbidden-terms && pnpm lint:external-hosts && pnpm lint:workflow-triggers && pnpm lint:workflow-policy && pnpm lint:lockfile-sources && pnpm lint:image-scan && pnpm lint:docs-published && pnpm lint:environment-docs && pnpm lint:release-plan",
    "lint:forbidden-terms": "bash scripts/check-forbidden-terms.test.sh && bash scripts/check-forbidden-terms.sh",
    "lint:external-hosts": "bash scripts/check-external-hosts.test.sh && bash scripts/check-external-hosts.sh",
    "lint:workflow-triggers": "bash scripts/check-workflow-triggers.test.sh && bash scripts/check-workflow-triggers.sh",
    "lint:workflow-policy": "node --test-reporter=dot scripts/check-workflow-policy.test.mjs && node scripts/check-workflow-policy.mjs",
    "lint:lockfile-sources": "bash scripts/check-lockfile-sources.test.sh && bash scripts/check-lockfile-sources.sh",
    "lint:image-scan": "bash scripts/scan-image.test.sh",
    "lint:docs-published": "bash scripts/docs-published-dispatch.test.sh",
    "lint:release-plan": "bash scripts/release-plan.test.sh",
    "lint:environment-docs": "bash scripts/check-environment-docs.test.sh && node scripts/check-environment-docs.mjs",
    "docs:check": "node scripts/docs-check/docs-check.ts",
    "typecheck": "turbo run typecheck",
    "test:unit": "turbo run test:unit",
    "test:integration": "sh -c 'turbo run test:integration \"$@\" && pnpm --filter @slugbase/db run test:integration:quiet' sh",
    "test:integration:pooled": "docker compose -f compose.dev.yml --profile pooler up -d --wait postgres pgbouncer && turbo run build --filter=@slugbase/db^... --filter=@slugbase/testing^... --filter=@slugbase/server^... && pnpm run test:integration:pooled:files",
    "test:integration:pooled:files": "SLUGBASE_TEST_POOLER_URL=127.0.0.1:64329 sh -c 'pnpm --filter @slugbase/db exec vitest run --project integration test/pooler.integration.test.ts && pnpm --filter @slugbase/testing exec vitest run --project integration test/tenancy-matrix.integration.test.ts && pnpm --filter @slugbase/server exec vitest run --project integration test/contract/contract.integration.test.ts'",
    "contracts:check": "turbo run contracts:check --continue",
    "db:check": "turbo run db:check",
    "i18n:check": "turbo run i18n:check",
    "test:e2e": "pnpm --filter @slugbase/e2e test:e2e",
    "audit": "pnpm audit --audit-level=high",
    "gate": "pnpm lint && turbo run typecheck test:unit build && pnpm contracts:check && pnpm db:check && pnpm test:integration && pnpm i18n:check && pnpm audit --audit-level=high",
    "db:generate": "pnpm --filter @slugbase/db db:generate",
    "db:migrate": "pnpm --filter @slugbase/db db:migrate",
    "perf": "turbo run build --filter=slugbase --filter=@slugbase/testing && node scripts/perf/run.mjs",
    "perf:migrations": "turbo run build --filter=@slugbase/testing && node scripts/perf/migrations.mjs",
    "db:seed": "turbo run build --filter=@slugbase/core... && pnpm --filter @slugbase/testing db:seed",
    "api:gen": "pnpm --filter @slugbase/contracts api:gen",
    "api:extract": "turbo run build && node tooling/api-report/api-report.ts extract",
    "dev:services": "docker compose -f compose.dev.yml up -d --wait",
    "dev:services:down": "docker compose -f compose.dev.yml down",
    "dev": "turbo run dev:server dev:worker dev:web",
    "dev:web": "pnpm --filter slugbase dev:web",
    "dev:env": "node scripts/dev-env.mjs",
    "ui:ladle": "pnpm --filter @slugbase/ui ladle"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@formatjs/icu-messageformat-parser": "^3.5.21",
    "@microsoft/api-extractor": "^7.59.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-plugin-i18next": "^6.1.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "unified": "^11.0.5",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "^0.25.0",
      "@ai-sdk/provider-utils": "^4.0.33",
      "@ladle/react>vite": "^6.4.5",
      "minimatch@<11.0.1": "^11.0.1"
    },
    "patchedDependencies": {
      "postgres@3.4.9": "patches/postgres@3.4.9.patch",
      "@stoplight/spectral-core@1.24.0": "patches/@stoplight__spectral-core@1.24.0.patch",
      "@redocly/openapi-core@1.34.20": "patches/@redocly__openapi-core@1.34.20.patch"
    }
  }
}
