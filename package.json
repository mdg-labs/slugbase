{
  "name": "slugbase",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "preinstall": "node scripts/check-node-version.mjs",
    "env:check": "bash scripts/with-ci-env.sh node -v && bash scripts/with-ci-env.sh pnpm -v && bash scripts/with-ci-env.sh node scripts/check-node-version.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "build": "turbo run build",
    "i18n:codegen": "node scripts/i18n-codegen-keys.mjs",
    "i18n:merge": "node scripts/i18n-merge-local-catalog.mjs",
    "i18n:validate": "node scripts/i18n-validate.mjs",
    "i18n:check:hardcoded": "bash scripts/check-hardcoded-ui-strings.sh",
    "check:client-api-origin": "bash scripts/check-client-api-origin.sh",
    "validate:docs-public": "node scripts/validate-docs-public.mjs",
    "test:scripts": "bash scripts/check-client-api-origin.sh && vitest run --config vitest.scripts.config.ts",
    "db:generate": "pnpm --filter @slugbase/backend db:generate",
    "db:migrate": "pnpm --filter @slugbase/backend db:migrate",
    "test:e2e": "bash scripts/e2e.sh",
    "e2e:direct": "playwright test --config e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.60.0",
    "@reportportal/agent-js-playwright": "5.2.3",
    "@reportportal/agent-js-vitest": "5.2.3",
    "@reportportal/client-javascript": "5.5.11",
    "@vitest/runner": "4.1.6",
    "@vscode/ripgrep": "^1.0.10",
    "eslint": "^9.28.0",
    "otplib": "^13.4.1",
    "postgres": "^3.4.7",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<0.28.1": ">=0.28.1",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3",
      "vitest": "^4.1.6"
    }
  }
}
