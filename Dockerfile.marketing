# syntax=docker/dockerfile:1
# Marketing static site — nginx (Coolify Cloud deploy)

FROM node:22-bookworm-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="${PNPM_HOME}:${PATH}"
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app

FROM base AS build-deps
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json tsconfig.json ./
COPY scripts/check-node-version.mjs scripts/check-node-version.mjs
COPY packages/marketing/package.json packages/marketing/
COPY packages/shared-types/package.json packages/shared-types/
COPY packages/ui/package.json packages/ui/
COPY patches/ patches/
RUN pnpm install --frozen-lockfile

FROM build-deps AS build
COPY packages/shared-types packages/shared-types
COPY packages/ui packages/ui
COPY packages/marketing packages/marketing

ARG PUBLIC_API_BASE_URL=
ARG PUBLIC_FRONTEND_ORIGIN=
ARG PUBLIC_MARKETING_ORIGIN=
ARG MARKETING_ORIGIN=
ENV PUBLIC_API_BASE_URL=$PUBLIC_API_BASE_URL
ENV PUBLIC_FRONTEND_ORIGIN=$PUBLIC_FRONTEND_ORIGIN
ENV PUBLIC_MARKETING_ORIGIN=$PUBLIC_MARKETING_ORIGIN
ENV MARKETING_ORIGIN=$MARKETING_ORIGIN

RUN pnpm exec turbo run build --filter=@slugbase/marketing...

FROM nginx:1.27-alpine AS runtime
COPY infra/nginx-marketing.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/packages/marketing/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
